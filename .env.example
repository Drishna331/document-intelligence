# Copy to .env; supply your own key. Never commit .env.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
HOST=0.0.0.0
PORT=8000
DATABASE_BACKEND=sqlite
# DATABASE_PATH=data/documents.sqlite3
# For ephemeral cloud hosting use DATABASE_BACKEND=turso and both values below.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
FINANCIAL_TOLERANCE=0.05
OCR_LANGUAGE=eng
OCR_DPI=220
OCR_TIMEOUT_SECONDS=40
LLM_TIMEOUT_SECONDS=120
MAX_CONCURRENT_DOCUMENTS=1
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=30000000
MAX_PAGES=3
# Same-origin dashboard needs no CORS setting. Optional comma-separated origins.
ALLOWED_ORIGINS=
